---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutIntro from '../components/AboutIntro.astro';
import AboutDetails from '../components/AboutDetails.astro';
import ContactForm from '../components/ContactForm.astro';
import { type Lang, t } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout lang={lang} title={t(lang, 'meta.about.title')}>
  <Header lang={lang} />
  <main id="main-content" class="about">
    <AboutIntro lang={lang} />
    <AboutDetails lang={lang} />
    <ContactForm lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .about { width: min(100% - 2 * (var(--gutter) + var(--rail)), 1040px); margin: 0 auto; padding-top: 96px; }
</style>
