---
import '../styles/global.css';
import { type Lang, defaultLang } from '../i18n/translations';
import { ClientRouter } from 'astro:transitions';
import { stripLocale, canonicalUrl, hreflangAlternates, ogLocale, siteJsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  title = 'Vyacheslav Plotnikov — Cinematographer in Luxembourg',
  description = 'Professional cinematographer, photographer and editor based in Luxembourg. Specializing in short films, documentaries, commercial work, and photography with a film-trained eye.',
  lang = defaultLang
} = Astro.props;

// Use full site URL for social media images (OG/Twitter require absolute URLs)
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://nickygrey.com';

// Derive canonical/hreflang/JSON-LD from the actual pathname only — never
// Astro.url.href or a constructed string, since stripLocale does not defend
// against query strings or hash fragments.
const { locale, path } = stripLocale(Astro.url.pathname);

// The URL is the ground truth for where a page renders — a page cannot lie
// about its own path, but it can easily forget to pass `lang` (which then
// silently defaults to 'en'). Trust the URL-derived locale for every piece
// of SEO metadata below, and fail the build loudly if a page's `lang` prop
// disagrees with it, so a forgotten or wrong prop is caught at build time
// instead of shipping a canonical/hreflang/html-lang mismatch to production.
if (lang !== locale) {
  throw new Error(
    `Layout: lang prop "${lang}" does not match the locale "${locale}" implied by ` +
    `the URL "${Astro.url.pathname}". Pass lang={'${locale}'} to <Layout>, or omit ` +
    `the prop and let it default — canonical, hreflang and html-lang must reflect ` +
    `where the page actually renders, not what it was told.`
  );
}

const canonical = canonicalUrl(path, locale);
const alternates = hreflangAlternates(path);
const jsonLd = siteJsonLd();
const isHome = path === '/';
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8">
  <!-- Prevent flash of wrong theme -->
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored || (prefersDark ? 'dark' : 'light');
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="cinematographer, photographer, editor, Luxembourg, documentary, short film, commercial, videographer">
  <meta name="author" content="Vyacheslav Plotnikov">
  <link rel="canonical" href={canonical}>
  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.hreflang} href={a.href} />
  ))}
  {isHome && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content="Professional cinematographer and photographer based in Luxembourg. Short films, documentaries, and commercial projects shot with a still photographer's eye.">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={`${siteUrl}/images/og.jpg`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content={ogLocale(locale)}>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content="Professional cinematographer and photographer based in Luxembourg.">
  <meta name="twitter:image" content={`${siteUrl}/images/og.jpg`}>

  <!-- Theme Color -->
  <meta name="theme-color" content="#f3f2f2">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg">

  <!-- Preconnect to external domains -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="dns-prefetch" href="https://www.youtube.com">
  <link rel="dns-prefetch" href="https://i.ytimg.com">

  <!-- Preload critical fonts -->
  <link rel="preload" href="https://fonts.gstatic.com/s/lora/v35/0QI6MX1D_JOuGQbT0gvTJPa787weuxJBkq0.woff2" as="font" type="font/woff2" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

  <!-- View Transitions -->
  <ClientRouter />

  <!-- Custom transition animations -->
  <style is:global>
    /* Fade transition (default) */
    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes fade-out {
      from { opacity: 1; }
      to { opacity: 0; }
    }

    /* Cinematic slide-up for content */
    @keyframes slide-up-in {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes slide-up-out {
      from {
        opacity: 1;
        transform: translateY(0);
      }
      to {
        opacity: 0;
        transform: translateY(-20px);
      }
    }

    /* View Transition animations */
    ::view-transition-old(root) {
      animation: fade-out 0.3s ease-out forwards;
    }
    ::view-transition-new(root) {
      animation: fade-in 0.4s ease-out forwards;
    }

    /* Main content slide transition */
    ::view-transition-old(main-content) {
      animation: slide-up-out 0.3s ease-in forwards;
    }
    ::view-transition-new(main-content) {
      animation: slide-up-in 0.4s ease-out 0.1s forwards;
    }

    /* Keep header stable during transitions */
    ::view-transition-old(header),
    ::view-transition-new(header) {
      animation: none;
    }
  </style>
</head>
<body>
  <!-- Page Loader -->
  <div class="page-loader" id="page-loader">
    <span class="loader-logo">p.v.</span>
  </div>

  <slot />

  <script>
    import { initMotion, teardownMotion } from '../motion';

    // Hide page loader - force hide with display:none as ultimate fallback
    function hideLoader() {
      const loader = document.getElementById('page-loader');
      if (loader) {
        loader.classList.add('is-hidden');
        loader.style.display = 'none';
      }
    }

    // Check if we've visited before (View Transition or reload)
    const hasVisited = sessionStorage.getItem('astro-visited') === 'true';
    sessionStorage.setItem('astro-visited', 'true');

    if (hasVisited) {
      // Returning visitor or View Transition: hide immediately
      hideLoader();
    } else {
      // First visit: brief loader animation
      if (document.readyState === 'complete') {
        setTimeout(hideLoader, 300);
      } else {
        window.addEventListener('load', () => setTimeout(hideLoader, 300));
      }
    }

    // Fallback: always hide after 1.5 seconds max
    setTimeout(hideLoader, 1500);

    // Hide on all View Transition lifecycle events
    document.addEventListener('astro:before-swap', hideLoader);
    document.addEventListener('astro:after-swap', hideLoader);
    document.addEventListener('astro:page-load', hideLoader);

    // Both calls are intentional, not redundant. The astro:page-load listener
    // is what actually guarantees correctness: that event is spec-guaranteed
    // to fire only after every deferred/module script on the page has run, so
    // it always sees every registerMotion() call — including ones from
    // components, regardless of where their <script> lands relative to this
    // one in the emitted HTML. The synchronous call just avoids waiting for
    // that event on first load. Do not remove either call.
    initMotion();
    document.addEventListener('astro:page-load', initMotion);
    document.addEventListener('astro:before-swap', teardownMotion);
  </script>
</body>
</html>
