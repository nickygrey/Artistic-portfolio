---
import { Image } from 'astro:assets';
import workAudienceImage from '../assets/work-audience.png';

const projects = [
  {
    url: 'https://www.youtube.com/watch?v=0Wb-eaG1Vio&t=71s',
    image: workAudienceImage,
    category: 'Documentary',
    title: 'Audience',
  },
  {
    url: 'https://www.youtube.com/watch?v=uqHGwlVwo8c&t=100s',
    image: 'https://img.youtube.com/vi/uqHGwlVwo8c/maxresdefault.jpg',
    category: 'Ugegraff Artist Interview',
    title: 'Nadine Robert',
  },
  {
    url: 'https://www.youtube.com/watch?v=ozb0hqq4Udg&t=10s',
    image: 'https://img.youtube.com/vi/ozb0hqq4Udg/maxresdefault.jpg',
    category: 'Ugegraff Artist Interview',
    title: 'Tetiana Popyk',
  },
  {
    url: 'https://www.youtube.com/watch?v=xN6xxZU8gqY',
    image: 'https://img.youtube.com/vi/xN6xxZU8gqY/maxresdefault.jpg',
    category: 'Ugegraff Artist Interview',
    title: 'Sarah Mandres',
  },
];
---

<section id="work" class="wrap work-section">
  <div class="work-header">
    <span class="kick" data-animation="split">Selected work</span>
    <a
      href="https://drive.google.com/drive/folders/1-yi1D4Q1SOvcCpneOJlK946MZpk0sRJo?usp=sharing"
      target="_blank"
      rel="noopener"
      class="archive-link"
    >
      Full archive ↗
    </a>
  </div>

  <div class="work-grid grid-2" data-animation="moveUp" data-stagger>
    {projects.map((project, index) => (
      <a
        href={project.url}
        target="_blank"
        rel="noopener"
        class="card-link"
      >
        <figure class="plate">
          <div class="project-thumbnail">
            <div class="project-scale" data-animation="scale" data-from="1.15" data-to="1" data-scrub>
              {typeof project.image === 'string' ? (
                <img
                  src={project.image}
                  alt={project.title}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Image
                  src={project.image}
                  alt={project.title}
                  width={1200}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 900px) 90vw, 45vw"
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
          </div>
        </figure>
        <div class="project-info">
          <div>
            <div class="kick project-category">{project.category}</div>
            <div class="project-title">{project.title}</div>
          </div>
          <span class="kick watch-link">Watch ↗</span>
        </div>
      </a>
    ))}
  </div>

  <div class="tags-row">
    <span class="tag tag-outline">More on the Drive archive</span>
    <span class="tag tag-outline">New work added regularly</span>
  </div>
</section>

<style>
  .work-section {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .work-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 38px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .archive-link {
    font-family: var(--font-body);
    font-size: 13px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 4vw, 52px) clamp(28px, 3vw, 44px);
  }

  .project-thumbnail {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .project-scale {
    width: 100%;
    height: 100%;
  }

  .project-scale img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-info {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 16px;
    gap: 16px;
  }

  .project-category {
    color: color-mix(in srgb, var(--color-text) 60%, transparent);
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 28px;
    letter-spacing: -.008em;
    margin-top: 5px;
  }

  .watch-link {
    color: var(--color-accent-700);
    white-space: nowrap;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 40px;
  }

  /* Mobile styles */
  @media (max-width: 900px) {
    .work-section {
      padding-top: 48px;
      padding-bottom: 40px;
    }

    .work-header {
      margin-bottom: 28px;
    }

    .work-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 600px) {
    .work-section {
      padding-top: 40px;
      padding-bottom: 32px;
    }

    .work-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 24px;
    }

    .project-title {
      font-size: 22px;
    }

    .project-info {
      flex-direction: column;
      gap: 8px;
      margin-top: 12px;
    }

    .tags-row {
      margin-top: 28px;
      gap: 8px;
    }

    .tag {
      font-size: 10px;
      padding: 4px 8px;
    }
  }

  /* Tap target: grow the hit region to the 44px minimum with padding,
     absorbed by an equal negative margin so the link renders in the same
     place at the same size — only the invisible touch area grows. */
  @media (hover: none) and (pointer: coarse) {
    .archive-link {
      padding: 12px 0;
      margin: -12px 0;
    }
  }
</style>
