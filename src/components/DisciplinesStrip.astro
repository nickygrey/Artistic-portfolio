---
const disciplines = ['Cinematography', 'Photography', 'Editing', 'Colour'];
---

<div class="wrap"><div class="divider"></div></div>
<div class="wrap disciplines-section">
  <!--
    data-min-width="381": below this, the `@media (max-width: 380px)` rule
    in this file's <style> block stacks the four disciplines as separate
    rows, which depends on the element's original <span> children being
    present and countable. SplitText's `split` primitive replaces those
    children with a single wrapper div, collapsing the stack into one
    unpunctuated run-on line. Skipping `split` below 381px leaves the
    original spans (and this layout) intact; at 381px and above the
    single-line layout applies and the split reveal runs normally.
  -->
  <p class="disciplines-line" data-animation="split" data-stagger data-min-width="381">
    {disciplines.map((discipline, index) => (
      <>
        <span>{discipline}</span>
        {index < disciplines.length - 1 && <span class="separator">·</span>}
      </>
    ))}
  </p>
</div>
<div class="wrap"><div class="divider"></div></div>

<style>
  .divider {
    height: 1px;
    background: var(--color-divider);
  }

  .disciplines-section {
    padding: clamp(28px, 4vw, 44px) 0;
    text-align: center;
  }

  .disciplines-line {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .separator {
    margin: 0 clamp(16px, 2.5vw, 32px);
    opacity: 0.4;
  }

  /* Mobile styles */
  @media (max-width: 600px) {
    .disciplines-section {
      padding: 20px 0;
    }

    .disciplines-line {
      font-size: clamp(14px, 4vw, 18px);
    }

    .separator {
      margin: 0 clamp(8px, 2vw, 16px);
    }
  }

  @media (max-width: 380px) {
    .disciplines-line {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .separator {
      display: none;
    }
  }
</style>
