---
import { type Lang, t } from '../i18n/translations';
import { LOCALES, localizedPath, stripLocale } from '../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { path } = stripLocale(Astro.url.pathname);
const home = localizedPath('/', lang);
const about = localizedPath('/about/', lang);
const section = path === '/' || path.startsWith('/work/') ? 'work' : path === '/about/' ? 'about' : null;
const current = (nav: string) => (nav === section ? 'page' : undefined);
---

<header class="site-header">
  <a class="site-header__name" href={home} data-nav="home">V. Plotnikov</a>
  <p class="site-header__eyebrow eyebrow">{t(lang, 'header.eyebrow')}</p>
  <nav class="site-header__nav" aria-label={t(lang, 'nav.label')}>
    <a href={home} data-nav="work" aria-current={current('work')}>{t(lang, 'nav.work')}</a>
    <a href={about} data-nav="about" aria-current={current('about')}>{t(lang, 'nav.about')}</a>
    <a href={`${about}#contact`} data-nav="contact">{t(lang, 'nav.contact')}</a>
    <ul class="site-header__locales" aria-label={t(lang, 'nav.language')}>
      {LOCALES.map((l) => (
        <li>
          <a href={localizedPath(path, l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined} data-locale={l}>
            {l.toUpperCase()}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 22px var(--gutter);
    font-size: var(--size-nav);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  /* Pages that scroll fade content out beneath the header; the gallery canvas, like the reference, has no backdrop. */
  :global(html:not(:has(.is-canvas))) .site-header {
    background: linear-gradient(var(--world-bg) 60%, color-mix(in srgb, var(--world-bg) 0%, transparent));
  }
  .site-header a { text-decoration: none; text-underline-offset: 4px; }
  .site-header a:hover { text-decoration: underline; }
  .site-header__eyebrow { margin: 0; opacity: 0.8; }
  .site-header__nav { justify-self: end; display: flex; align-items: center; gap: 16px; }
  .site-header__locales { display: flex; gap: 2px; margin: 0 0 0 4px; padding: 0; list-style: none; opacity: 0.7; }
  /* WCAG 2.2 target size: each language link is at least 24×24px to hit, whatever its text size. */
  .site-header__locales a { display: grid; place-items: center; min-width: 24px; min-height: 24px; }
  .site-header__nav a[aria-current] { text-decoration: underline; }

  /* Same width as --rail in global.css: below it the centred eyebrow no longer fits beside the nav. */
  @media (max-width: 1100px) {
    .site-header { grid-template-columns: 1fr auto; }
    .site-header__eyebrow {
      position: fixed;
      left: calc(var(--gutter) - 4px);
      top: 50%;
      writing-mode: vertical-rl;
      transform: translateY(-50%) rotate(180deg);
    }
  }
  @media (max-width: 480px) {
    .site-header { font-size: 11px; }
    .site-header__nav { gap: 10px; }
    .site-header__locales { gap: 0; margin-left: 0; }
  }
</style>
