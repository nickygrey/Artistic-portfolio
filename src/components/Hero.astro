---
import { type Lang, t } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section id="top" class="hero-fullscreen" data-header-theme="dark">
  <!-- Background image with parallax -->
  <div class="hero-bg" data-animation="hero">
    <img
      src={`${base}images/hero.jpg`}
      alt=""
      class="hero-img"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
  </div>

  <!-- Content -->
  <div class="hero-content wrap">
    <span class="kick hero-tagline" data-animation="moveUp" data-delay="0.1">{t(lang, 'hero.tagline')}</span>
    <h1 class="disp hero-h" data-animation="split" data-stagger>
      <span class="title-line">{t(lang, 'hero.title1')}</span>
      <span class="title-line">{t(lang, 'hero.title2')}</span>
    </h1>
    <p class="prose hero-desc" data-animation="moveUp" data-delay="0.2">{t(lang, 'hero.desc')}</p>
    <div class="hero-ctas" data-animation="moveUp" data-delay="0.3">
      <a href="#reel" class="btn btn-primary">{t(lang, 'hero.cta')}</a>
      <a href="https://instagram.com/nickygreys" target="_blank" rel="noopener" class="btn btn-ghost">Instagram</a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero-fullscreen {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  /* Background image container */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* Mobile: center on subject */
  @media (max-width: 768px) {
    .hero-img {
      object-position: center 25%;
    }
  }

  /* Dark overlay for text readability */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.3) 0%,
      rgba(0, 0, 0, 0.5) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
  }

  /* Content styling */
  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 120px;
    padding-bottom: 120px;
    color: rgba(255, 255, 255, 0.95);
  }

  .hero-tagline {
    color: rgba(255, 255, 255, 0.7);
  }

  .hero-h {
    font-size: clamp(48px, 10vw, 120px);
    line-height: 0.95;
    margin: clamp(16px, 2vw, 24px) 0 0;
    margin-left: -0.04em;
    color: #fff;
  }

  .title-line {
    display: block;
  }

  .hero-desc {
    font-size: clamp(16px, 1.5vw, 19px);
    max-width: 48ch;
    margin: clamp(24px, 3vw, 36px) 0 0;
    color: rgba(255, 255, 255, 0.8);
  }

  .hero-ctas {
    display: flex;
    gap: 14px;
    margin-top: clamp(28px, 4vw, 40px);
    flex-wrap: wrap;
  }

  /* Light button styling for dark background */
  .hero-ctas .btn {
    border-color: rgba(255, 255, 255, 0.4);
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-ctas .btn:hover {
    border-color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .hero-ctas .btn-ghost {
    border-color: transparent;
  }

  .hero-ctas .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.6), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% {
      opacity: 0.5;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.2);
    }
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .hero-content {
      padding-top: 100px;
      padding-bottom: 100px;
    }

    .hero-h {
      font-size: clamp(36px, 12vw, 64px);
    }

    .hero-desc {
      font-size: 15px;
      max-width: 100%;
    }

    .hero-ctas {
      gap: 12px;
    }

    .hero-ctas .btn {
      flex: 1;
      min-width: 130px;
      text-align: center;
      justify-content: center;
    }

    .scroll-indicator {
      bottom: 24px;
    }

    .scroll-line {
      height: 30px;
    }
  }

  @media (max-width: 480px) {
    .hero-h {
      font-size: clamp(32px, 14vw, 48px);
    }

    .hero-ctas {
      flex-direction: column;
    }

    .hero-ctas .btn {
      width: 100%;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-tagline,
    .hero-h,
    .hero-desc,
    .hero-ctas,
    .scroll-indicator {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .hero-img {
      transform: none;
      transition: none;
    }

    .scroll-line {
      animation: none;
    }
  }
</style>

<script>
  import { registerMotion } from '../motion';

  registerMotion('hero', (el, { gsap }) => {
    const img = el.querySelector('.hero-img');
    if (!img) return;

    // Zoom and drift on one timeline, so neither can clobber the other's transform.
    gsap.timeline({
      scrollTrigger: {
        trigger: el,
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    })
      .fromTo(img, { scale: 1.08, yPercent: 0 }, { scale: 1, yPercent: 12, ease: 'none' }, 0);

    // .scroll-indicator is a sibling of el (both live under .hero-fullscreen),
    // not a descendant of el itself — scope from the shared ancestor rather
    // than document so this can't silently pick up an unrelated element if
    // .scroll-indicator is ever reused elsewhere or Hero renders twice.
    const indicator = el.closest('.hero-fullscreen')?.querySelector('.scroll-indicator');
    if (indicator) {
      gsap.to(indicator, {
        opacity: 0,
        scrollTrigger: { trigger: el, start: 'top top', end: '30% top', scrub: true },
      });
    }
  });
</script>
