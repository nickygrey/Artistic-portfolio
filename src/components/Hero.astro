---
import { Image } from 'astro:assets';
import { type Lang, t } from '../i18n/translations';
import { HERO_IMAGE, HERO_WIDTHS, HERO_QUALITY, HERO_FORMAT, HERO_SIZES } from '../lib/hero-image';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="top" class="hero-fullscreen" data-header-theme="dark">
  <!-- Background image with parallax -->
  <div class="hero-bg" data-animation="hero">
    <Image
      src={HERO_IMAGE}
      alt=""
      class="hero-img"
      width={HERO_WIDTHS[HERO_WIDTHS.length - 1]}
      widths={HERO_WIDTHS}
      sizes={HERO_SIZES}
      format={HERO_FORMAT}
      quality={HERO_QUALITY}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
  </div>

  <!-- Content -->
  <div class="hero-content wrap">
    <span class="kick hero-tagline" data-animation="moveUp" data-delay="0.1">{t(lang, 'hero.tagline')}</span>
    <h1 class="disp hero-h" data-animation="split" data-stagger>
      <span class="title-line">{t(lang, 'hero.title1')}</span>
      <span class="title-line">{t(lang, 'hero.title2')}</span>
    </h1>
    <p class="prose hero-desc" data-animation="moveUp" data-delay="0.2">{t(lang, 'hero.desc')}</p>
    <div class="hero-ctas" data-animation="moveUp" data-delay="0.3">
      <a href="#reel" class="btn btn-primary">{t(lang, 'hero.cta')}</a>
      <a href="https://instagram.com/nickygreys" target="_blank" rel="noopener" class="btn btn-ghost">Instagram</a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero-fullscreen {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  /*
   * Background image container. Deliberately carries NO z-index (stays at
   * the default `auto`) rather than the `-1` it used to have: a negative
   * z-index on a *positioned* element creates its own stacking context and
   * traps every descendant inside it at that one negative level, painted
   * as a single atomic unit relative to everything outside this element —
   * including .hero-overlay below, which needs to independently escape to
   * sit above the WebGL canvas (see src/webgl/renderer.ts's z-index
   * comment) despite being nested in here with the raw photograph. This
   * `auto` is what makes that escape possible at all: with `.hero-bg` at
   * `z-index: -1`, .hero-overlay's own `z-index: 1` (below) would still be
   * trapped inside this element's negative-level unit and could not reach
   * the canvas's stacking bucket to compete with it. (`.hero-img` itself
   * is not "plain, non-positioned" in practice either — see
   * renderer.ts's z-index comment for why — but that is a separate, DOM-
   * order-resolved concern from the trap this comment is about.)
   */
  .hero-bg {
    position: absolute;
    inset: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* Mobile: center on subject */
  @media (max-width: 768px) {
    .hero-img {
      object-position: center 25%;
    }
  }

  /*
   * Dark overlay for text readability. Explicit z-index: 1 (matching
   * .hero-content below) is load-bearing, not decorative: without it this
   * element has z-index:auto and — now that .hero-bg above no longer traps
   * it in a negative stacking context — would land in the same "z-index:
   * 0/auto" stacking bucket as the WebGL canvas (src/webgl/renderer.ts,
   * appended inside <main id="main-content"> as its LAST child). Ties at
   * the same bucket paint in DOM order, and this overlay sits earlier in
   * <main> than that canvas does, so it would lose the tie and end up
   * hidden behind it — exactly the class of bug that made .hero-content's
   * text vanish behind an opaque canvas fill before this file's z-index
   * scheme (and the canvas's placement inside <main>, not document.body —
   * see renderer.ts) were both fixed. An explicit z-index here escapes
   * that bucket the same way .hero-content's already does.
   */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.3) 0%,
      rgba(0, 0, 0, 0.5) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
  }

  /* Content styling */
  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 120px;
    padding-bottom: 120px;
    color: rgba(255, 255, 255, 0.95);
  }

  .hero-tagline {
    color: rgba(255, 255, 255, 0.7);
  }

  .hero-h {
    font-size: clamp(48px, 10vw, 120px);
    line-height: 0.95;
    margin: clamp(16px, 2vw, 24px) 0 0;
    margin-left: -0.04em;
    color: #fff;
  }

  .title-line {
    display: block;
  }

  .hero-desc {
    font-size: clamp(16px, 1.5vw, 19px);
    max-width: 48ch;
    margin: clamp(24px, 3vw, 36px) 0 0;
    color: rgba(255, 255, 255, 0.8);
  }

  .hero-ctas {
    display: flex;
    gap: 14px;
    margin-top: clamp(28px, 4vw, 40px);
    flex-wrap: wrap;
  }

  /* Light button styling for dark background */
  .hero-ctas .btn {
    border-color: rgba(255, 255, 255, 0.4);
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-ctas .btn:hover {
    border-color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .hero-ctas .btn-ghost {
    border-color: transparent;
  }

  .hero-ctas .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /*
   * Scroll indicator. `z-index: 1` is the same load-bearing escape
   * `.hero-overlay` and `.hero-content` above already make, for the same
   * reason: this is a control layered over the hero photograph, and without
   * an explicit z-index it sits at `auto` in the same "z-index: 0/auto"
   * paint bucket as the WebGL canvas (src/webgl/renderer.ts, appended inside
   * <main id="main-content"> as its LAST child). Ties in that bucket resolve
   * by DOM order and this element is earlier in <main> than the canvas, so
   * it loses — measured, before this line existed, as being swallowed whole
   * by the hero mesh (fully covered: zero of its own pixels survived). The
   * `transform: translateX(-50%)` below is not an escape either; a transform
   * makes this its own stacking context but leaves it in that same bucket.
   */
  .scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 50%;
    z-index: 1;
    transform: translateX(-50%);
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.6), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% {
      opacity: 0.5;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.2);
    }
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .hero-content {
      padding-top: 100px;
      padding-bottom: 100px;
    }

    .hero-h {
      font-size: clamp(36px, 12vw, 64px);
    }

    .hero-desc {
      font-size: 15px;
      max-width: 100%;
    }

    .hero-ctas {
      gap: 12px;
    }

    .hero-ctas .btn {
      flex: 1;
      min-width: 130px;
      text-align: center;
      justify-content: center;
    }

    .scroll-indicator {
      bottom: 24px;
    }

    .scroll-line {
      height: 30px;
    }
  }

  @media (max-width: 480px) {
    .hero-h {
      font-size: clamp(32px, 14vw, 48px);
    }

    .hero-ctas {
      flex-direction: column;
    }

    .hero-ctas .btn {
      width: 100%;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-tagline,
    .hero-h,
    .hero-desc,
    .hero-ctas,
    .scroll-indicator {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .hero-img {
      transform: none;
      transition: none;
    }

    .scroll-line {
      animation: none;
    }
  }
</style>

<script>
  import { registerMotion } from '../motion';
  import { DURATION, EASE, SCALE_FROM } from '../motion/tokens';
  import { registerSurface, supported, WEBGL_READY_EVENT } from '../webgl';
  import { computeCoverUv, parseObjectPosition } from '../webgl/geometry';
  import { heroShader, heroUniforms, normaliseScrollVelocity } from '../webgl/shaders/hero';

  registerMotion('hero', (el, { gsap, ScrollTrigger }) => {
    const img = el.querySelector('.hero-img') as HTMLImageElement | null;
    if (!img) return;

    // Zoom and drift on one timeline, so neither can clobber the other's transform.
    gsap.timeline({
      scrollTrigger: {
        trigger: el,
        start: 'top top',
        end: 'bottom top',
        scrub: true,
      },
    })
      .fromTo(img, { scale: SCALE_FROM, yPercent: 0 }, { scale: 1, yPercent: 12, ease: EASE.none }, 0);

    // .scroll-indicator is a sibling of el (both live under .hero-fullscreen),
    // not a descendant of el itself — scope from the shared ancestor rather
    // than document so this can't silently pick up an unrelated element if
    // .scroll-indicator is ever reused elsewhere or Hero renders twice.
    const indicator = el.closest('.hero-fullscreen')?.querySelector('.scroll-indicator');
    if (indicator) {
      gsap.to(indicator, {
        opacity: 0,
        scrollTrigger: { trigger: el, start: 'top top', end: '30% top', scrub: true },
      });
    }

    // --- Uniforms for the WebGL surface ------------------------------------
    //
    // The surface itself is registered on WEBGL_READY_EVENT below, not here —
    // Layout.astro runs initMotion() before initWebGL(), and initWebGL()
    // opens by destroying every registered surface, so anything registered
    // from inside this handler would be thrown away microseconds later. What
    // does belong here is the per-frame feed, because this is where the
    // ScrollTrigger it reads from and the gsap.ticker slot it runs in both
    // come from, and because it must be torn down with the rest of the
    // motion system rather than outliving it.
    //
    // The <img> is never hidden by any of this. If WebGL is unavailable,
    // unsupported, or torn down by the fps guard, none of it happens and the
    // photograph is simply the photograph.
    if (!supported()) return;

    // Smooth the velocity rather than snapping the uniform to it: a raw
    // ScrollTrigger reading is a stepped 50ms-window estimate and drives a
    // visibly jittery smear. Same gsap.quickTo treatment (and the same
    // tokens) the marquee's scroll-velocity boost already uses.
    const setVelocity = gsap.quickTo(heroUniforms.uVelocity, 'value', {
      duration: DURATION.quickTo,
      ease: EASE.smooth,
    });

    // `object-fit: cover` inputs change only when the image decodes (or a
    // srcset swap changes which file decoded) or the viewport resizes, so
    // this recomputes on change rather than every frame — the key comparison
    // is what keeps getComputedStyle() off the per-frame path. The rect read
    // is free: surface.ts's own update() has already forced layout this frame.
    let coverKey = '';
    function syncCover(): void {
      const r = img!.getBoundingClientRect();
      const key = `${Math.round(r.width)}x${Math.round(r.height)}|${img!.naturalWidth}x${img!.naturalHeight}`;
      if (key === coverKey) return;
      coverKey = key;
      const cover = computeCoverUv(
        { width: img!.naturalWidth, height: img!.naturalHeight },
        { width: r.width, height: r.height },
        parseObjectPosition(getComputedStyle(img!).objectPosition)
      );
      heroUniforms.uCoverScale.value = cover.scale;
      heroUniforms.uCoverOffset.value = cover.offset;
    }

    // Sampled every frame, not from ScrollTrigger's own onUpdate, because
    // onUpdate stops firing the instant scrolling stops — leaving the last
    // (high) reading as the smoothing target forever, i.e. a smear frozen
    // across the photograph. ScrollTrigger.getVelocity() divides by the time
    // since its last recorded sample, so continuing to read it decays to zero
    // on its own once the page is still.
    function sampleScroll(): void {
      syncCover();
      setVelocity(normaliseScrollVelocity(velocityTracker.getVelocity()));
    }

    // gsap.ticker callbacks are not tracked by teardownMotion() (it kills
    // ScrollTriggers and reverts SplitTexts, nothing else — see AGENTS.md),
    // so this one is removed by the onKill of a ScrollTrigger created in the
    // same breath, exactly as PhotoCarousel.astro's marquee unhooks its own
    // listeners. Same object is also what supplies the velocity, so there is
    // no second scroll observer on the page.
    const velocityTracker = ScrollTrigger.create({
      onKill: () => gsap.ticker.remove(sampleScroll),
    });
    gsap.ticker.add(sampleScroll);
  });

  /**
   * One surface per live scene. WEBGL_READY_EVENT fires at the end of every
   * successful initWebGL() — once on first load and once per View Transition
   * — and never at all when WebGL is unsupported, blocked or refused under
   * reduced motion, so this is exactly the set of moments at which a fresh,
   * empty scene exists and wants its surfaces back. Registering from module
   * scope rather than from a lifecycle listener of our own is deliberate: it
   * removes any dependence on whether this component's script happens to be
   * emitted before or after Layout.astro's (see renderer.ts's comment on the
   * event, and Layout.astro's on why it calls initMotion() twice).
   */
  document.addEventListener(WEBGL_READY_EVENT, () => {
    const img = document.querySelector('.hero-img') as HTMLImageElement | null;
    if (img) registerSurface(img, heroShader);
  });
</script>
