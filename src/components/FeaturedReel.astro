---
import { type Lang, t } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const youtubeUrl = 'https://www.youtube.com/watch?v=0Wb-eaG1Vio&t=71s';
const base = import.meta.env.BASE_URL;
---

<section id="reel" class="wrap reel-section">
  <div class="reel-header">
    <div>
      <span class="kick">{t(lang, 'reel.label')}</span>
      <h2 class="disp reel-title" data-animation="split" data-stagger>{t(lang, 'reel.title')}</h2>
    </div>
    <a href={youtubeUrl} target="_blank" rel="noopener" class="youtube-link">
      {t(lang, 'reel.youtube')}
    </a>
  </div>
  <a href={youtubeUrl} target="_blank" rel="noopener" class="reel-link">
    <div class="reel-frame">
      <div class="reel-thumbnail" data-animation="parallax" data-speed="0.6">
        <img
          src={`${base}images/Screenshot 2026-07-19 at 12.25.53.png`}
          alt="Showreel - UGEGRAAF Documentary"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="reel-overlay">
        <span class="play-btn">
          <svg class="play-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </span>
      </div>
    </div>
  </a>
</section>

<style>
  .reel-section {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .reel-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 26px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .reel-title {
    font-size: clamp(34px, 4vw, 48px);
    margin: 12px 0 0;
  }

  .youtube-link {
    font-family: var(--font-body);
    font-size: 14px;
  }

  .reel-link {
    display: block;
    text-decoration: none;
  }

  /* Untransformed clip owner: .reel-thumbnail is scrub-parallaxed (GSAP
     writes an inline transform continuously), so it cannot own the overflow
     clip on itself — its own boundary would translate in lockstep and never
     mask the excursion. .reel-frame sits between it and the visible frame,
     stays untransformed, and does the clipping. */
  .reel-frame {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    border-radius: 4px;
    background: #0a0806;
  }

  /* Oversized and inset beyond the frame so the ±48px scroll-driven travel
     (DISTANCE.lg * speed = 80 * 0.6) never uncovers the frame's background.
     Percentage, not a fixed px, so the overscan scales with the frame: for
     position:absolute, top/bottom percentages resolve against the
     containing block's (.reel-frame's) height, not .reel-thumbnail's own.
     A fixed px overscan is a much bigger fraction of a short mobile frame
     than a tall desktop one, so it crops the image tighter on small
     screens purely as a side effect -- this must hold at the smallest
     supported frame, not just at a desktop preview:
       320px viewport, .wrap padding 12px (<=380px breakpoint) ->
       frame width  = 320 - 2*12       = 296px
       frame height = 296 * 9/16       = 166.5px
       required overscan (each side)   >= 48px
       48 / 166.5                      = 28.83%
     32% clears that with ~11% headroom (0.32 * 166.5 = 53.3px), and clears
     the 375px case even more easily (0.32 * 197.4 = 63.2px). Because the
     frame's own aspect-ratio is fixed at 16/9, this percentage yields the
     *same* box-height : frame-height ratio at every viewport, so the
     resulting object-fit: cover crop is identical at 375px and 1440px
     (verified live -- see task-9-report.md). */
  .reel-thumbnail {
    position: absolute;
    inset: -32% 0;
  }

  .reel-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reel-link:hover .reel-thumbnail img {
    transform: scale(1.03);
  }

  .reel-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
  }

  .reel-link:hover .reel-overlay {
    background: rgba(0, 0, 0, 0.4);
  }

  .play-btn {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: #1a1816;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
  }

  .reel-link:hover .play-btn {
    transform: scale(1.08);
  }

  .play-icon {
    width: 28px;
    height: 28px;
    margin-left: 3px;
  }

  @media (max-width: 900px) {
    .reel-section {
      padding-top: 48px;
      padding-bottom: 32px;
    }

    .reel-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }

  @media (max-width: 600px) {
    .reel-section {
      padding-top: 40px;
      padding-bottom: 24px;
    }

    .reel-title {
      font-size: clamp(26px, 7vw, 34px);
    }

    .play-btn {
      width: 56px;
      height: 56px;
    }

    .play-icon {
      width: 22px;
      height: 22px;
    }
  }

  /* Tap target: grow the hit region to the 44px minimum with padding,
     absorbed by an equal negative margin so the link renders in the same
     place at the same size — only the invisible touch area grows.
     12px (not the brief's 11px) because the raw, unrounded intrinsic
     height measures ~21.69px, not a flat 22 — 11px/side lands at 43.69,
     a hair under the 44px threshold the automated test checks against
     the unrounded value. */
  @media (hover: none) and (pointer: coarse) {
    .youtube-link {
      padding: 12px 0;
      margin: -12px 0;
    }
  }
</style>
