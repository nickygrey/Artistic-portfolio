---
// src/components/ImageBand.astro
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** Empty string marks the band decorative; screen readers skip it. */
  alt: string;
}
const { src, alt } = Astro.props;

/**
 * Widths this band offers. `sizes="100vw"` means a wide desktop viewport
 * resolves the top end of this list, so it goes all the way to 3000 for
 * the real (eventually landscape, presumably >=3000px-native) photography
 * this component is built for.
 *
 * The literal `width` below is deliberately the *smallest* entry, not the
 * largest (contrast Hero.astro, which uses its own widths list's largest
 * entry — safe there only because hero.jpg's native width, 2400px, already
 * exceeds every entry in that list). `width` is not read from `widths` by
 * Astro's own srcset builder — it drives a separate, unclamped fallback
 * render, and the three stand-in photographs currently behind this
 * component are only 1066px wide natively. Passing the largest entry
 * (3000) as `width` asked Astro to *upscale* a 1066px source to 3000px for
 * that fallback — verified live: it produced a 562kB file, blowing the
 * 400kB budget on an image that was blurrier, not sharper, than the
 * source. `widths` itself doesn't have this problem — Astro's own
 * getSrcSet() clamps every entry to the source's native width for ESM
 * imports (node_modules/astro/dist/assets/services/service.js) — only the
 * standalone `width` prop is unclamped. The smallest entry (900) avoids
 * upscaling no matter how small a future source image is, while still
 * being a sane fallback width for a large one — it is deliberately not
 * read off `src.width` (see below).
 *
 * `width` is a literal number, not `src.width` — reading `.width` off the
 * imported ImageMetadata in component code trips astro:assets'
 * `referencedImages` proxy (see node_modules/astro/dist/assets/utils/proxy.js)
 * and leaks a raw, unprocessed copy of the source into the build, which also
 * blew the 400kB per-file budget when tried here. `<Image>` also has no
 * `formats` prop — that belongs to `<Picture>` and is silently ignored here;
 * webp (measured smaller than avif for this photo set: 739kB vs 1259kB on
 * the hero at 2560w, equal quality) is set explicitly via `format` instead.
 */
const WIDTHS = [900, 1440, 1920, 2560, 3000];
---

<!--
  data-header-theme="dark" pairs with .band-scrim below, exactly like
  Hero.astro pairs its own data-header-theme="dark" with .hero-overlay.
  The marker alone (without a scrim guaranteeing darkness under the header)
  would only work for a photograph that happens to be dark at the top —
  the current bright stand-in is what exposed that this pairing, not the
  marker alone, is what the header's contrast actually depends on. See
  .band-scrim below for the gradient this guarantees.
-->
<div class="band" data-header-theme="dark" role={alt === '' ? 'presentation' : undefined}>
  <Image
    src={src}
    alt={alt}
    width={WIDTHS[0]}
    widths={WIDTHS}
    sizes="100vw"
    format="webp"
    quality={80}
    loading="lazy"
    decoding="async"
  />
  <div class="band-scrim" aria-hidden="true"></div>
</div>

<style>
  .band {
    position: relative;
    width: 100%;
    margin-inline: calc(50% - 50vw);
    max-width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .band img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /*
   * Guarantees header legibility regardless of what the photograph behind
   * it looks like — this is the actual fix, not the data-header-theme
   * marker alone (see the comment above the .band div). The header sits in
   * the top ~90px at its tallest (desktop, two 22px paddings plus content),
   * comfortably inside this gradient's opaque top zone on every viewport
   * this site supports; it is fully transparent again by 34%, well before
   * the frame's midpoint. Unlike .hero-overlay (which darkens the whole
   * frame because hero copy sits mid-image), a band's only job is to
   * darken the strip the fixed header floats over — the photograph itself
   * is the point, so the scrim must not read as a wash over it.
   *
   * The 0.9 peak looks steep on paper but is confined to a thin top strip
   * and reads as a normal top vignette in practice (verified against
   * band-1's bright sky stand-in — see task-3-report.md for the measured
   * WCAG contrast ratios this achieves for the logo, a navlink, and the
   * language switcher, in both themes). It was tuned up from an initial
   * 0.65 peak, which left the language switcher under 4.5:1 against this
   * stand-in's brightest sky pixels — i.e. sized for a real bright
   * photograph, not just guessed.
   */
  .band-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(0, 0, 0, 0.68) 10%,
      rgba(0, 0, 0, 0.24) 22%,
      rgba(0, 0, 0, 0) 34%
    );
  }

  /* A full viewport of image is overwhelming on a phone held vertically,
     and eats the scroll budget. Two-thirds keeps the impact, not the fatigue. */
  @media (max-width: 900px) {
    .band { height: 66vh; height: 66dvh; }
  }
</style>
