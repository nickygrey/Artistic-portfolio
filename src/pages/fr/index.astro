---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import DisciplinesStrip from '../../components/DisciplinesStrip.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import FeaturedReel from '../../components/FeaturedReel.astro';
import SelectedWork from '../../components/SelectedWork.astro';
import About from '../../components/About.astro';
import Services from '../../components/Services.astro';
import Testimonials from '../../components/Testimonials.astro';
import Contact from '../../components/Contact.astro';
import Partners from '../../components/Partners.astro';
import Footer from '../../components/Footer.astro';
import ImageBand from '../../components/ImageBand.astro';
import band1 from '../../assets/band-1.jpg';
import band2 from '../../assets/band-2.jpg';
import band3 from '../../assets/band-3.jpg';

const lang = 'fr';
---

<Layout lang={lang} title="Vyacheslav Plotnikov — Cinéaste & Photographe, Luxembourg">
  <div>
    <Header lang={lang} />

    <main id="main-content" transition:name="main-content" transition:animate="slide">
      <Hero lang={lang} />
      <DisciplinesStrip />
      <ImageBand src={band1} alt="" />
      <PhotoCarousel />
      <ImageBand src={band3} alt="" />
      <FeaturedReel lang={lang} />
      <SelectedWork />
      <ImageBand src={band2} alt="" />
      <About lang={lang} />
      <Services lang={lang} />
      <Testimonials lang={lang} />
      <Contact lang={lang} />
      <Partners lang={lang} />
    </main>

    <Footer lang={lang} />
  </div>
</Layout>
